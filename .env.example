# Telegram bot tokeni (@BotFather dan)
BOT_TOKEN=

# Yashirin super admin(lar) Telegram ID si, vergul bilan: 123456789,987654321
SUPER_ADMIN_IDS=

# Admin panel buyrug'i (slashsiz)
ADMIN_COMMAND=admin

# Kunlik eslatma vaqtlari (Toshkent vaqti)
REMINDER_TIMES=10:00,18:00

# Kunlik zaxira nusxa super adminlarga (bo'sh qoldirilsa — o'chiriladi)
BACKUP_TIME=23:00

# Vaqt zonasi siljishi, daqiqada (Toshkent = UTC+5 = 300)
TZ_OFFSET_MIN=300

COMPANY_NAME=Unicon Soft

# Baza fayli. Render'da: /var/data/unicon.db (doimiy disk)
DB_PATH=data/unicon.db
